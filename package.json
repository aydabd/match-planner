{
	"name": "matchplanner",
	"version": "0.17.0",
	"private": true,
	"description": "Rattvis byteshanterare for ungdomsfotboll (5v5/7v7/9v9/11v11). Ren statisk PWA, inga runtime-beroenden.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -p tsconfig.json --noEmit && vite build",
		"preview": "vite preview",
		"check": "biome ci .",
		"check:policy": "node scripts/check-policy.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.5.14",
		"@playwright/test": "1.63.0",
		"@types/node": "24.19.0",
		"@vitest/coverage-v8": "5.0.2",
		"typescript": "7.0.2",
		"vite": "8.3.1",
		"vitest": "5.0.2"
	}
}
