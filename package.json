{
	"name": "matchplanner",
	"version": "0.2.1",
	"private": true,
	"description": "Rattvis byteshanterare for ungdomsfotboll (5v5/7v7/9v9/11v11). Ren statisk PWA, inga runtime-beroenden.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -p tsconfig.json --noEmit && vite build",
		"preview": "vite preview",
		"check": "biome ci .",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"typescript": "7.0.2",
		"vite": "8.3.1",
		"vitest": "5.0.2"
	}
}
